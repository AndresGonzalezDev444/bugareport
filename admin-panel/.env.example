# BugaReport Admin Panel — Variables de entorno
# ⚠️  Este archivo NUNCA debe subirse a Git (.gitignore ya lo excluye)
# ⚠️  Copia este archivo como .env y llena los valores reales

# ── Credenciales de acceso al panel (HASHES SHA-256) ────────────────────────
# Para generar los hashes, ejecuta en terminal:
#   node -e "const s=require('js-sha256');console.log(s('TU_USUARIO'))"
#   node -e "const s=require('js-sha256');console.log(s('TU_CONTRASENA'))"
#
VITE_ADMIN_USER_HASH=PON_AQUI_EL_SHA256_DEL_USUARIO
VITE_ADMIN_PASS_HASH=PON_AQUI_EL_SHA256_DE_LA_CONTRASENA

# ── Supabase (misma instancia que la app móvil Flutter) ─────────────────────
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
